  <identAndStatusSection>
    <dmAddress>
      <dmIdent>
        <dmCode modelIdentCode="ODMRAD" systemDiffCode="A" systemCode="34"
                subSystemCode="1" subSubSystemCode="0" assyCode="01"
                disassyCode="00" disassyCodeVariant="A"
                infoCode="720" infoCodeVariant="A" itemLocationCode="A"/>
        <language languageIsoCode="en" countryIsoCode="US"/>
        <issueInfo issueNumber="001" inWork="00"/>
      </dmIdent>
      <dmAddressItems>
        <issueDate year="2026" month="10" day="01"/>
        <dmTitle>
          <techName>Array Module</techName>
          <infoName>Install Procedure</infoName>
        </dmTitle>
      </dmAddressItems>
    </dmAddress>
    <dmStatus issueType="new">
      <security securityClassification="01"/>
      <responsiblePartnerCompany enterpriseName="Synthetic"/>
      <originator enterpriseName="Synthetic"/>
      <applic>
        <displayText>
          <simplePara>All configurations.</simplePara>
        </displayText>
      </applic>
      <brexDmRef>
        <dmRef>
          <dmRefIdent>
            <dmCode modelIdentCode="ODMRAD" systemDiffCode="A" systemCode="34"
                    subSystemCode="1" subSubSystemCode="0" assyCode="01"
                    disassyCode="00" disassyCodeVariant="A"
                    infoCode="720" infoCodeVariant="A" itemLocationCode="A"/>
          </dmRefIdent>
        </dmRef>
      </brexDmRef>
      <qualityAssurance>
        <unverified/>
      </qualityAssurance>
    </dmStatus>
  </identAndStatusSection>
  <content>
    <procedure>
      <preliminaryRqmts>
        <reqSupportEquips>
          <reqSupportEquip>
            <supportEquipDescrGroup>
              <supportEquipDescr>
                <name>array module extraction tool</name>
                <identNumber>
                  <manufacturerCode>ODM</manufacturerCode>
                  <partAndSerialNumber>
                    <partNumber>ODM-SE-0001</partNumber>
                  </partAndSerialNumber>
                </identNumber>
              </supportEquipDescr>
            </supportEquipDescrGroup>
          </reqSupportEquip>
        </reqSupportEquips>
        <reqSpares>
          <reqSpare>
            <spareDescrGroup>
              <spareDescr>
                <name>array module</name>
                <identNumber>
                  <manufacturerCode>ODM</manufacturerCode>
                  <partAndSerialNumber>
                    <partNumber>ODM-AM-0001</partNumber>
                  </partAndSerialNumber>
                </identNumber>
              </spareDescr>
              <reqQuantity>1</reqQuantity>
            </spareDescrGroup>
          </reqSpare>
        </reqSpares>
        <reqSafety>
          <warning>
            <warningAndCautionPara>Disconnect power before removal.</warningAndCautionPara>
          </warning>
        </reqSafety>
      </preliminaryRqmts>
      <mainProcedure>
        <proceduralStep>
          <para>Position the replacement array module, ODM-AM-0001, in the open array module
          position.</para>
        </proceduralStep>
        <proceduralStep>
          <para>Install the two mounting screws using the array module extraction tool,
          ODM-SE-0001.</para>
        </proceduralStep>
        <proceduralStep>
          <para>Connect the array module connector; confirm the connector gasket seats fully.</para>
        </proceduralStep>
        <proceduralStep>
          <para>Restore power to the array.</para>
        </proceduralStep>
        <proceduralStep>
          <para>Run BIT; confirm MRAD-ARR-0417 clears.</para>
        </proceduralStep>
      </mainProcedure>
      <closeRqmts>
        <closeStep>
          <para>Close the array access panel.</para>
        </closeStep>
        <closeStep>
          <para>Refer to the illustrated parts data for item callouts and quantities.</para>
          <dmRef>
            <dmRefIdent>
              <dmCode modelIdentCode="ODMRAD" systemDiffCode="A" systemCode="34"
                      subSystemCode="1" subSubSystemCode="0" assyCode="01"
                      disassyCode="00" disassyCodeVariant="A"
                      infoCode="941" infoCodeVariant="A" itemLocationCode="A"/>
            </dmRefIdent>
          </dmRef>
        </closeStep>
      </closeRqmts>
    </procedure>
  </content>
</dmodule>
