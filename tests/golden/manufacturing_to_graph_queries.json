      "query": "MERGE (p:Part:MANUFACTURING {id: $part_id}) MERGE (proc:Procedure:MANUFACTURING {id: $proc_node_id}) SET proc.procedure_id = $proc_id MERGE (p)-[:REQUIRES_PROCEDURE]->(proc) MERGE (s:ManufacturingStep:MANUFACTURING {id: $step_node_id}) SET s.step_id = $step_id, s.raw_text = $instruction_text, s.action = $action, s.is_value_added = $is_value_added, s.is_safety_critical = $is_safety_critical, s.process_category = $process_category, s.justification = $justification, s.estimated_duration_minutes = $estimated_duration_minutes, s.consumables = $consumables, s.standard_ref = $standard_ref MERGE (proc)-[:CONTAINS_STEP]->(s) WITH s MERGE (k:OntologyClass {uri: $target_ontology_class}) MERGE (s)-[:INSTANCE_OF]->(k) WITH s UNWIND $tools AS t_name MERGE (tool:Tool:MANUFACTURING {id: \"tool_\" + t_name}) SET tool.part_number = t_name MERGE (s)-[:REQUIRES_TOOL]->(tool) WITH s MERGE (n:Hazard:MANUFACTURING {id: $hazard_class_id}) SET n.class = $hazard_class MERGE (s)-[:HAS_HAZARD]->(n) WITH s MERGE (n:Certification:MANUFACTURING {id: $required_cert_id}) SET n.certification = $required_cert MERGE (s)-[:REQUIRES_CERT]->(n) WITH s UNWIND $military_and_industry_standards AS val MERGE (n:Standard:MANUFACTURING {id: \"std_\" + val}) SET n.name = val MERGE (s)-[:GOVERNED_BY]->(n) WITH s UNWIND $internal_part_numbers AS val MERGE (n:Part:MANUFACTURING {id: \"part_\" + val}) SET n.part_number = val MERGE (s)-[:REQUIRES_PART]->(n) WITH s UNWIND $material_and_hardware_slang AS val MERGE (n:SlangTerm:MANUFACTURING {id: \"slang_\" + val}) SET n.term = val MERGE (s)-[:USABLE_SLANG]->(n) WITH s UNWIND $figures AS fig_ref MERGE (f:Figure:MANUFACTURING {id: \"fig_\" + fig_ref}) ON CREATE SET f.url = $image_prefix + fig_ref + \".png\", f.title = fig_ref MERGE (s)-[:REFERENCES_FIGURE]->(f)"
    },
