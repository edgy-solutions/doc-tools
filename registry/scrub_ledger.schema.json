{
  "$comment": "GENERATED by scripts/generate_scrub_ledger_schema.py from doc_tools/scrub/ledger.py -- do not edit. This schema expresses the SHAPE of a ledger, including the redaction pattern for every original value. It does NOT express the cross-field invariants: shape equality of each replacement, occurrences == len(sites), policy.mapping agreeing with scrub.mapping_ref, injectivity of the mapping, or a replacement colliding with an allowlisted string. Those are enforced only by ScrubLedger.model_validate(). Validating against this file alone checks a ledger's shape, not its truth.",
  "$defs": {
    "AllowlistRule": {
      "description": "Why a string survived verbatim (design \u00a73.1).\n\n``MANUFACTURER_NAME`` and ``DATE`` are declared here although rulings 1 and 2\nhave not landed: the enum says the rule EXISTS, the allowlist file says\nwhether it is in force, and ``Policy`` records which way a given scrub ran.",
      "enum": [
        "header_vocabulary",
        "caption",
        "date",
        "notice_type_or_status",
        "unit_package_or_standard",
        "manufacturer_name"
      ],
      "title": "AllowlistRule",
      "type": "string"
    },
    "Allowlisted": {
      "additionalProperties": false,
      "description": "A string that survived verbatim, and the count that proves it.\n\nThe count is the whole entry: ``Alternative Part Number`` present but\nappearing twice where the source had it three times means a header was\nscrubbed, which is the failure that makes a fixture test nothing.",
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "rule": {
          "$ref": "#/$defs/AllowlistRule"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "rule",
        "count"
      ],
      "title": "Allowlisted",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "One verification check with its measured result.",
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "measurements": {
          "additionalProperties": true,
          "title": "Measurements",
          "type": "object"
        },
        "result": {
          "$ref": "#/$defs/CheckResult"
        }
      },
      "required": [
        "result",
        "detail"
      ],
      "title": "Check",
      "type": "object"
    },
    "CheckName": {
      "description": "The verification checks (design \u00a74.3). **All of them are required.**",
      "enum": [
        "leak_test",
        "shape_equality",
        "allowlist_integrity",
        "structure_invariance",
        "equivalence_seal",
        "collision_check"
      ],
      "title": "CheckName",
      "type": "string"
    },
    "CheckResult": {
      "enum": [
        "pass",
        "fail",
        "refused",
        "not_run"
      ],
      "title": "CheckResult",
      "type": "string"
    },
    "MappingPolicy": {
      "enum": [
        "retained",
        "one_way"
      ],
      "title": "MappingPolicy",
      "type": "string"
    },
    "Policy": {
      "additionalProperties": false,
      "description": "Which answer to each open ruling this scrub ran under.\n\nThis block is why the schema could land before the rulings. It does not\ndecide them; it makes a fixture state its own assumptions, so a ruling that\nlands later invalidates exactly the fixtures that disagree with it \u2014 which is\na query, not an audit.",
      "properties": {
        "authority": {
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "dates": {
          "$ref": "#/$defs/PolicyAnswer"
        },
        "enters_scored_corpus": {
          "title": "Enters Scored Corpus",
          "type": "boolean"
        },
        "manufacturer_name": {
          "$ref": "#/$defs/PolicyAnswer"
        },
        "mapping": {
          "$ref": "#/$defs/MappingPolicy"
        }
      },
      "required": [
        "manufacturer_name",
        "dates",
        "mapping",
        "enters_scored_corpus",
        "authority"
      ],
      "title": "Policy",
      "type": "object"
    },
    "PolicyAnswer": {
      "enum": [
        "allowlisted",
        "scrubbed"
      ],
      "title": "PolicyAnswer",
      "type": "string"
    },
    "ScrubRun": {
      "additionalProperties": false,
      "description": "How the scrub was run, so it can be reproduced or disbelieved.",
      "properties": {
        "allowlist_ref": {
          "title": "Allowlist Ref",
          "type": "string"
        },
        "mapping_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Ref"
        },
        "run_at": {
          "title": "Run At",
          "type": "string"
        },
        "salt_ref": {
          "title": "Salt Ref",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "run_at",
        "salt_ref",
        "allowlist_ref"
      ],
      "title": "ScrubRun",
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "description": "Where an occurrence was. A table cell is addressed, body text is not.\n\nThe address matters because the same original appearing in a cell and in a\nparagraph is the case a naive per-occurrence scrub gets wrong, and it is\nalso the replacement-pair case the fixture exists to test.",
      "properties": {
        "col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "row": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        }
      },
      "required": [
        "page",
        "kind"
      ],
      "title": "Site",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "The document that was scrubbed, named by location and digest only.",
      "properties": {
        "bucket": {
          "title": "Bucket",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "pages": {
          "minimum": 1,
          "title": "Pages",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^len=(0|[1-9][0-9]*) sha256:[0-9a-f]{8}$",
          "title": "Sha256",
          "type": "string"
        },
        "tables": {
          "minimum": 0,
          "title": "Tables",
          "type": "integer"
        }
      },
      "required": [
        "bucket",
        "key",
        "sha256",
        "pages",
        "tables"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Substitution": {
      "additionalProperties": false,
      "description": "One original -> replacement, with the original present only as a digest.",
      "properties": {
        "class": {
          "$ref": "#/$defs/SubstitutionClass"
        },
        "occurrences": {
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        },
        "original": {
          "pattern": "^len=(0|[1-9][0-9]*) sha256:[0-9a-f]{8}$",
          "title": "Original",
          "type": "string"
        },
        "redraws": {
          "default": 0,
          "minimum": 0,
          "title": "Redraws",
          "type": "integer"
        },
        "replacement": {
          "minLength": 1,
          "title": "Replacement",
          "type": "string"
        },
        "reserved_space": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reserved Space"
        },
        "shape": {
          "minLength": 1,
          "title": "Shape",
          "type": "string"
        },
        "sites": {
          "items": {
            "$ref": "#/$defs/Site"
          },
          "minItems": 1,
          "title": "Sites",
          "type": "array"
        }
      },
      "required": [
        "class",
        "shape",
        "original",
        "replacement",
        "occurrences",
        "sites"
      ],
      "title": "Substitution",
      "type": "object"
    },
    "SubstitutionClass": {
      "description": "What a substituted string WAS. Not a guess: the scrubber knows which\ncolumn or block it took the value from, and a reviewer auditing a fixture\nneeds to know whether an affected part or a customer name was replaced.",
      "enum": [
        "mpn_affected",
        "mpn_replacement",
        "mpn_alias",
        "customer_name",
        "customer_part_number",
        "contact_name",
        "contact_email",
        "contact_phone",
        "address",
        "site_name",
        "internal_reference",
        "distribution_block"
      ],
      "title": "SubstitutionClass",
      "type": "string"
    },
    "Verification": {
      "additionalProperties": false,
      "description": "Every check in ``CheckName``, each with a result. No defaults.",
      "properties": {
        "checks": {
          "additionalProperties": {
            "$ref": "#/$defs/Check"
          },
          "propertyNames": {
            "$ref": "#/$defs/CheckName"
          },
          "title": "Checks",
          "type": "object"
        }
      },
      "required": [
        "checks"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "$id": "https://edgy-solutions.com/schema/scrub_ledger_v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The committed ledger. One per fixture, beside it.\n\n``ScrubLedger.model_validate(...)`` is the single door into this type, and\nevery invariant below is enforced there rather than in the writer, because\nthe reader is who has to be protected: a ledger hand-edited to paste an\noriginal back in must fail to LOAD.",
  "properties": {
    "allowlisted": {
      "items": {
        "$ref": "#/$defs/Allowlisted"
      },
      "title": "Allowlisted",
      "type": "array"
    },
    "fixture_id": {
      "minLength": 1,
      "title": "Fixture Id",
      "type": "string"
    },
    "ledger_version": {
      "title": "Ledger Version",
      "type": "integer"
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "scrub": {
      "$ref": "#/$defs/ScrubRun"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "substitutions": {
      "items": {
        "$ref": "#/$defs/Substitution"
      },
      "title": "Substitutions",
      "type": "array"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    }
  },
  "required": [
    "ledger_version",
    "fixture_id",
    "source",
    "scrub",
    "substitutions",
    "allowlisted",
    "verification",
    "policy"
  ],
  "title": "Scrub ledger v1",
  "type": "object"
}
