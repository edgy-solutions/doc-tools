@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix s3kl: <http://www.semanticstep.org/s3000l#> . 
@prefix pcn: <http://internal/sustainment/pcn#> .

<http://internal/sustainment/pcn> a owl:Ontology ;
    rdfs:label "PCN and PDN Sustainment Extension" ;
    rdfs:comment "Custom extension for doc-tools to handle DMSMS, obsolescence, and part replacements." .

# --- Classes ---
pcn:SustainmentNotice a owl:Class .
pcn:ProcessChangeNotification a owl:Class ; rdfs:subClassOf pcn:SustainmentNotice .
pcn:ProductDiscontinuationNotice a owl:Class ; rdfs:subClassOf pcn:SustainmentNotice .
pcn:ChangeCategory a owl:Class .

# --- Object Properties (Graph Edges) ---
pcn:subjectToNotice a owl:ObjectProperty ;
    rdfs:label "Subject To Notice" .
pcn:hasReplacement a owl:ObjectProperty ;
    rdfs:label "Has Replacement" .
pcn:hasChangeCategory a owl:ObjectProperty ;
    rdfs:domain pcn:SustainmentNotice ;
    rdfs:range pcn:ChangeCategory .

# --- Data Properties (Literals) ---
pcn:hasLastTimeBuyDate a owl:DatatypeProperty ;
    rdfs:domain pcn:ProductDiscontinuationNotice ;
    rdfs:range xsd:date .
pcn:hasEffectivityDate a owl:DatatypeProperty ;
    rdfs:domain pcn:SustainmentNotice ;
    rdfs:range xsd:date .