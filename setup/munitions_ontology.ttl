@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix iof:   <http://example.com/iof#> .
@prefix isa95: <http://example.com/isa95#> .
@prefix mfg:   <http://example.com/manufacturing#> .

### Ontology Declaration ###
<http://example.com/munitions-ontology> a owl:Ontology ;
    owl:imports <https://raw.githubusercontent.com/iofoundry/ontology/master/core/Core.rdf> ,
                <https://raw.githubusercontent.com/hsu-aut/IndustrialStandard-ODP-DINEN62264-2/v1.4.2/DINEN62264.owl> ;
    rdfs:label "Munitions Acceleration & Manufacturing (MAT) IOF Ontology" ;
    rdfs:comment "Extends IOF Core and ISA-95 (IEC 62264) with custom explosives defense logic and cross-industry equivalence mappings." .

#################################################################
#    Object Properties
#################################################################

mfg:hasCrossIndustryEquivalence a owl:ObjectProperty ;
    rdfs:label "has cross industry equivalence" ;
    rdfs:comment "Maps custom defense processes back to generic standard industrial processes." .

mfg:hasHazardClass a owl:ObjectProperty ;
    rdfs:label "has hazard class" ;
    rdfs:domain mfg:MunitionsAssemblyStep ;
    rdfs:range mfg:ExplosivesSafetyHazard .

mfg:appliesToHazardClass a owl:ObjectProperty ;
    rdfs:label "applies to hazard class" ;
    rdfs:domain mfg:ComplianceRule ;
    rdfs:range mfg:ExplosivesSafetyHazard .

#################################################################
#    Data Properties
#################################################################

mfg:hasManualReference a owl:DatatypeProperty ;
    rdfs:domain mfg:ComplianceRule ;
    rdfs:range xsd:string .

mfg:hasTargetMetric a owl:DatatypeProperty ;
    rdfs:domain mfg:ComplianceRule ;
    rdfs:range xsd:string .

#################################################################
#    Classes
#################################################################

isa95:MaterialClass a owl:Class .
isa95:ProcessSegment a owl:Class .

mfg:ExplosiveMaterial a owl:Class ;
    rdfs:subClassOf isa95:MaterialClass ;
    rdfs:label "Explosive Material" ;
    rdfs:comment "Custom material class for explosive munitions." .

mfg:MunitionsAssemblyStep a owl:Class ;
    rdfs:subClassOf isa95:ProcessSegment ;
    rdfs:label "Munitions Assembly Step" ;
    rdfs:comment "Subclasses ISA-95 ProcessSegment to explicitly model discrete assembly steps for munitions." .

mfg:ExplosivesSafetyHazard a owl:Class ;
    rdfs:label "Explosives Safety Hazard (ESQD)" .

mfg:Class_1_1 a owl:Class ;
    rdfs:subClassOf mfg:ExplosivesSafetyHazard ;
    rdfs:label "Class 1.1 Hazard (Mass Explosion)" .

mfg:Class_1_3 a owl:Class ;
    rdfs:subClassOf mfg:ExplosivesSafetyHazard ;
    rdfs:label "Class 1.3 Hazard (Mass Fire)" .

mfg:ComplianceRule a owl:Class ;
    rdfs:label "Compliance Rule" ;
    rdfs:comment "A constraint or directive derived from a regulatory manual (e.g. DAFMAN 21-201 Requirements)." .

mfg:StandardIndustrialProcess a owl:Class ;
    rdfs:label "Standard Industrial Process" ;
    rdfs:comment "A generic standard industrial process for cross-industry mappings." .

#################################################################
#    Individuals (Mappings)
#################################################################

mfg:Composite_Layup_Automotive a mfg:StandardIndustrialProcess ;
    rdfs:label "Composite Layup (Automotive Industry Standard)" .

mfg:PCB_Soldering_Commercial a mfg:StandardIndustrialProcess ;
    rdfs:label "PCB Soldering (Commercial Electronics Standard)" .

mfg:Warhead_Composite_Layup a mfg:MunitionsAssemblyStep ;
    rdfs:label "Warhead Composite Layup" ;
    mfg:hasCrossIndustryEquivalence mfg:Composite_Layup_Automotive .

mfg:Fuse_PCB_Soldering a mfg:MunitionsAssemblyStep ;
    rdfs:label "Fuse PCB Soldering" ;
    mfg:hasCrossIndustryEquivalence mfg:PCB_Soldering_Commercial .
