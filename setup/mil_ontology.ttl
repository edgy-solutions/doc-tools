@prefix mil: <http://edgy-solutions.com/ontology/mil#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix iof: <https://spec.industrialontologies.org/ontology/core/Core/> .

mil:MIL_Ontology a owl:Ontology ;
    rdfs:label "Unified Military Technical Manual Ontology" ;
    rdfs:comment "Bridges S1000D, IADS, and DITA into a single equipment graph." .

# --- CORE CLASSES ---

mil:DataModule a owl:Class ; rdfs:subClassOf iof:InformationContentEntity ; rdfs:label "S1000D Data Module" .
mil:IadsNode a owl:Class ; rdfs:subClassOf iof:InformationContentEntity ; rdfs:label "IADS XML Node" .
mil:DitaNode a owl:Class ; rdfs:subClassOf iof:InformationContentEntity ; rdfs:label "DITA Task or Topic" .
mil:Tool a owl:Class ; rdfs:subClassOf iof:MaterialArtifact ; rdfs:label "Support Equipment or Tool" .
mil:Part a owl:Class ; rdfs:subClassOf iof:MaterialArtifact ; rdfs:label "Spare Part" .

# --- OBJECT PROPERTIES ---

mil:requiresTool a owl:ObjectProperty ; rdfs:domain iof:InformationContentEntity ; rdfs:range mil:Tool ; rdfs:label "Requires Tool" .
mil:hasPart a owl:ObjectProperty ; rdfs:domain iof:InformationContentEntity ; rdfs:range mil:Part ; rdfs:label "Has Spare Part" .

# --- DATATYPE PROPERTIES ---

mil:hasInstructionText a owl:DatatypeProperty ; rdfs:domain iof:InformationContentEntity ; rdfs:range xsd:string ; rdfs:label "Instruction Text" .
mil:hasWarning a owl:DatatypeProperty ; rdfs:domain iof:InformationContentEntity ; rdfs:range xsd:string ; rdfs:label "Safety Warning" .
mil:hasSNS a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "Standard Numbering System Code" .
mil:hasInfoCode a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "S1000D Information Code" .
